gfx/2d/ad/poi_attack
{
	nopicmip
	novlcollapse
	{
		map gfx/2d/ad/attack_tint.tga
		blendfunc add
		rgbgen vertex
	}
	{
		map gfx/2d/ad/attack.tga
		blendfunc blend
		rgbgen identity
	}
}

gfx/2d/ad/poi_capture
{
	nopicmip
	novlcollapse
	{
		map gfx/2d/ad/capture_tint.tga
		blendfunc add
		rgbgen vertex
	}
	{
		map gfx/2d/ad/capture.tga
		blendfunc blend
		rgbgen identity
	}
}

gfx/2d/ad/poi_defend
{
	nopicmip
	novlcollapse
	{
		map gfx/2d/ad/defend_tint.tga
		blendfunc add
		rgbgen vertex
	}
	{
		map gfx/2d/ad/defend.tga
		blendfunc blend
		rgbgen identity
	}
}

//shader by Kr3m

sprites/flagcarrier
{
	nomipmaps
	nopicmip
	{
		map sprites/flagcarrier.tga
		blendfunc blend
		rgbgen vertex
	}
}

sprites/flagcarrier_hit
{
	nomipmaps
	nopicmip
	{
		map sprites/flagcarrier_hit.tga
		blendfunc blend
	}
}


sprites/neutralflagcarrier
{
	nomipmaps
	nopicmip
	{
		map sprites/flagcarrier_neutral.tga
		blendfunc	GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbgen vertex
	}
}
